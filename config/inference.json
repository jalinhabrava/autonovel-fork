{
  "defaults": {
    "provider": "anthropic",
    "timeout_seconds": 600,
    "retries": 2
  },
  "roles": {
    "writer": {
      "provider": "anthropic",
      "model_env": "AUTONOVEL_WRITER_MODEL",
      "model": "claude-sonnet-4-6",
      "temperature": 0.7,
      "max_tokens": 16000
    },
    "judge": {
      "provider": "anthropic",
      "model_env": "AUTONOVEL_JUDGE_MODEL",
      "model": "claude-opus-4-6",
      "temperature": 0.3,
      "max_tokens": 4000
    },
    "review": {
      "provider": "anthropic",
      "model_env": "AUTONOVEL_REVIEW_MODEL",
      "model": "claude-opus-4-6",
      "temperature": 0.3,
      "max_tokens": 8000
    }
  },
  "tasks": {
    "seed": {
      "role": "writer",
      "temperature": 1.0,
      "max_tokens": 4000,
      "timeout_seconds": 120,
      "extra_headers": {
        "anthropic-beta": "context-1m-2025-08-07"
      }
    },
    "gen_world": {
      "role": "writer",
      "temperature": 0.7,
      "max_tokens": 16000,
      "timeout_seconds": 300
    },
    "gen_characters": {
      "role": "writer",
      "temperature": 0.7,
      "max_tokens": 16000,
      "timeout_seconds": 300
    },
    "gen_canon": {
      "role": "writer",
      "temperature": 0.2,
      "max_tokens": 16000,
      "timeout_seconds": 300
    },
    "gen_outline": {
      "role": "writer",
      "temperature": 0.5,
      "max_tokens": 16000,
      "extra_headers": {
        "anthropic-beta": "context-1m-2025-08-07"
      }
    },
    "gen_outline_part2": {
      "role": "writer",
      "temperature": 0.5,
      "max_tokens": 16000,
      "timeout_seconds": 600
    },
    "draft_chapter": {
      "role": "writer",
      "temperature": 0.8,
      "max_tokens": 16000,
      "timeout_seconds": 600,
      "extra_headers": {
        "anthropic-beta": "context-1m-2025-08-07"
      }
    },
    "gen_revision": {
      "role": "writer",
      "temperature": 0.8,
      "max_tokens": 16000,
      "timeout_seconds": 600,
      "extra_headers": {
        "anthropic-beta": "context-1m-2025-08-07"
      }
    },
    "evaluate_judge": {
      "role": "judge",
      "temperature": 0.3,
      "max_tokens": 2000,
      "timeout_seconds": 180,
      "extra_headers": {
        "anthropic-beta": "context-1m-2025-08-07"
      }
    },
    "adversarial_edit": {
      "role": "judge",
      "temperature": 0.3,
      "max_tokens": 8000,
      "timeout_seconds": 300
    },
    "compare_chapters": {
      "role": "judge",
      "temperature": 0.2,
      "max_tokens": 4000,
      "timeout_seconds": 300
    },
    "reader_panel": {
      "role": "judge",
      "temperature": 0.7,
      "max_tokens": 4000,
      "timeout_seconds": 300
    },
    "review_full": {
      "role": "review",
      "temperature": 0.3,
      "max_tokens": 8000,
      "timeout_seconds": 600,
      "extra_headers": {
        "anthropic-beta": "context-1m-2025-08-07"
      }
    },
    "author_understanding": {
      "role": "judge",
      "temperature": 0.1,
      "max_tokens": 2000,
      "timeout_seconds": 180,
      "retries": 1
    },
    "author_response": {
      "role": "writer",
      "temperature": 0.3,
      "max_tokens": 1200,
      "timeout_seconds": 180,
      "retries": 1
    },
    "bootstrap_normalization": {
      "role": "judge",
      "temperature": 0.1,
      "max_tokens": 2000,
      "timeout_seconds": 180,
      "retries": 1
    },
    "derived_source_understanding": {
      "role": "judge",
      "temperature": 0.1,
      "max_tokens": 2200,
      "timeout_seconds": 240,
      "retries": 1
    },
    "build_arc_summary": {
      "role": "writer",
      "temperature": 0.1,
      "max_tokens": 4000,
      "timeout_seconds": 120
    },
    "build_outline": {
      "role": "judge",
      "temperature": 0.1,
      "max_tokens": 1500,
      "timeout_seconds": 120
    },
    "gen_audiobook_script": {
      "role": "writer",
      "temperature": 0.1,
      "max_tokens": 8000,
      "timeout_seconds": 300,
      "extra_headers": {
        "anthropic-beta": "context-1m-2025-08-07"
      }
    }
  }
}
