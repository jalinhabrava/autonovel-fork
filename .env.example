# Anthropic API key (required when AUTONOVEL_TEXT_PROVIDER=anthropic)
ANTHROPIC_API_KEY=sk-ant-...

# Active text provider:
#   anthropic
#   openai
#   lmstudio
#   ollama
#   anthropic_compatible
#   openai_compatible
AUTONOVEL_TEXT_PROVIDER=anthropic

# Project storage backend:
#   workspace
#   vault
AUTONOVEL_PROJECT_BACKEND=workspace

# Required only when AUTONOVEL_PROJECT_BACKEND=vault
AUTONOVEL_VAULT_ROOT=

# Writer model (used for drafting and revision)
AUTONOVEL_WRITER_MODEL=claude-sonnet-4-6

# Judge model (used for evaluation — should differ from writer)
AUTONOVEL_JUDGE_MODEL=claude-sonnet-4-6

# Review model (Opus — deep prose-level analysis, used in Phase 3b)
AUTONOVEL_REVIEW_MODEL=claude-opus-4-6

# Optional Anthropic-compatible base URL
AUTONOVEL_API_BASE_URL=https://api.anthropic.com

# OpenAI API key (required only when AUTONOVEL_TEXT_PROVIDER=openai)
OPENAI_API_KEY=sk-proj-...

# Optional OpenAI-compatible base URL
AUTONOVEL_OPENAI_API_BASE_URL=https://api.openai.com/v1

# Optional LM Studio auth token and base URL
AUTONOVEL_LMSTUDIO_API_KEY=
AUTONOVEL_LMSTUDIO_API_BASE_URL=http://localhost:1234/v1

# Optional Ollama auth token and base URL
AUTONOVEL_OLLAMA_API_KEY=
AUTONOVEL_OLLAMA_API_BASE_URL=http://localhost:11434/v1

# Generic Anthropic-compatible provider settings
AUTONOVEL_ANTHROPIC_COMPATIBLE_API_KEY=
AUTONOVEL_ANTHROPIC_COMPATIBLE_API_BASE_URL=

# Generic OpenAI-compatible provider settings
AUTONOVEL_OPENAI_COMPATIBLE_API_KEY=
AUTONOVEL_OPENAI_COMPATIBLE_API_BASE_URL=

# fal.ai key for image generation (Nano Banana 2)
FAL_KEY=your-fal-api-key-here

# ElevenLabs API key for audiobook generation
ELEVENLABS_API_KEY=your-elevenlabs-api-key-here
