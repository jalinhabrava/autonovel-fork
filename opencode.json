{
  "$schema": "https://opencode.ai/config.json",
  "provider": {
    "openai": {
      "npm": "@ai-sdk/openai",
      "name": "OpenAI"
    }
  },
  "model": "openai/gpt-4.1-mini",
  "small_model": "openai/gpt-4.1-mini",
  "permission": {
    "edit": "ask",
    "bash": "ask"
  },
  "watcher": {
    "ignore": [
      ".git/**",
      ".venv/**",
      "__pycache__/**",
      ".pytest_cache/**",
      "node_modules/**",
      "dist/**",
      ".mypy_cache/**",
      ".ruff_cache/**",
      ".idea/**",
      ".vscode/**",
      "*.log",
      "*.lock"
    ]
  },
  "compaction": {
    "auto": true,
    "prune": true,
    "reserved": 10000
  },
  "instructions": [
    "docs/ARCHITECTURE_NOTES.md",
    "docs/TODO_PHASE1.md"
  ]
}
